    "adm-zip": "^0.6.1",
    "diff": "^9.0.0",
    "php-parser": "^3.7.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6"
  }
